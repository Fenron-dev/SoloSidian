\outl0\strokewidth0 \strokec2 Keine Pflichtabh\'e4ngigkeiten von anderen Community-Plugins.\
\ls61\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	2	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Offline-Funktionalit\'e4t ohne KI oder externe Dienste.\
\ls61\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	3	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Spielwelten und Regelwerke voneinander trennen.\
\ls61\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	4	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Benutzerdefinierte Daten und manuelle \'c4nderungen respektieren.\
\ls61\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	5	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Relevante Entit\'e4ten als normale Markdown-Notizen mit stabilen IDs und Wikilinks speichern.\
\ls61\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	6	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Native Obsidian-Templates und Bases bevorzugen.\
\ls61\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	7	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Erweiterbarkeit durch versionierte Content-, Ruleset-, Generator-, Oracle- und Adventure-Packs vorbereiten.\
\ls61\ilvl0\kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	8	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 Keine permanente Simulation von NPCs oder ganzen Spielwelten.\
